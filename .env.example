# Copia este archivo a `.env` y ajusta los valores.
# SECRET_KEY: clave para firmar sesiones/CSRF. Genera una propia en producción.
SECRET_KEY=cambia-esta-clave-por-una-aleatoria

# Ruta de la base de datos (opcional). Por defecto: instance/gestor.sqlite
# DATABASE_URL=sqlite:///instance/gestor.sqlite
